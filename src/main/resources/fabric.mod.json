{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "icon": "icon.png",
    "description": "${mod_description}",
    "authors": [
        "Polyfrost"
    ],
    "environment": "client",
    "entrypoints": {
        "preLaunch": [
            "org.polyfrost.polyplus.PolyPlusPreLaunch"
        ],
        "client": [
            "org.polyfrost.polyplus.PolyPlusEntrypoint"
        ],
        "voicechat": [
            "org.polyfrost.polyplus.client.network.p2p.P2PVoicechatPlugin"
        ],
        "debugify": [
            "org.polyfrost.polyplus.compat.DebugifyBannableFixes"
        ]
    },
    "languageAdapters": {
        "polyplus-early": "org.polyfrost.polyplus.compat.EarlyConfigAdapter"
    },
    "mixins": [
        "mixins.${mod_id}.json"
    ],
    "depends": {
        "minecraft": "${minor_mc_version}",
        "fabric-api": "*",
        "fabricloader": ">=0.16.0",
        "java": ">=21",
        "fabric-language-kotlin": ">=1.13.13",
        "oneconfigv1": ">=${oneconfig_version}",
        "compose-multiplatform": ">=1.0.6"
    },
    "breaks": {
        "auto-reauth": "*",
        "wwaypoints": "<0.8.0"
    }
}
